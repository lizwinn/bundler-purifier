#!/usr/bin/env ruby
# SPDX-License-Identifier: MIT
#
# bundler-purifier: the commands of the nix-purifiers contract for Bundler.
#
#   bundler-purifier lock [--force]   record what Gemfile.lock cannot, when
#                                     the Gemfile, Gemfile.lock or a gemspec
#                                     changed (or always, with --force)
#   bundler-purifier prefetch [ARGS]  realize the locked gems and the dev
#                                     shell, with GC roots, and install the
#                                     bundle from them offline
#   bundler-purifier publish [ARGS]   push the gems that Nix built
#
# The commands run in the project root, where the Gemfile is. The purifier
# lockfile lies beside Gemfile.lock, or where `--lockfile <path>` or
# BUNDLER_PURIFIER_LOCKFILE says, for a project whose build is kept
# outside it. The package that installs this script sets
# BUNDLER_PURIFIER_LIB (its Nix library), BUNDLER_PURIFIER_SHARED_FLAKE
# (the shared nix-purifiers library) and BUNDLER_PURIFIER_NIXPKGS (the
# nixpkgs it builds with).

require "bundler"
require "digest"
require "fileutils"
require "json"
require "open3"
require "rubygems/package"
require "rubygems/remote_fetcher"
require "uri"
require "tmpdir"
require "yaml"

module BundlerPurifier
  LOCK_FILE = "bundler-purifier.lock.json"
  LOCK_VERSION = 3

  module_function

  def fail!(message)
    warn "bundler-purifier: #{message}"
    exit 1
  end

  def run!(env, *cmd, chdir:)
    ok = system(env, *cmd, chdir: chdir)
    fail!("could not run #{cmd.first}; it is not on PATH") if ok.nil?
    fail!("#{cmd.join(" ")} failed") unless ok
  end

  def capture!(*cmd)
    out, status = Open3.capture2(*cmd)
    fail!("#{cmd.join(" ")} failed") unless status.success?
    out
  end

  def sri(path)
    "sha256-#{Digest::SHA256.file(path).base64digest}"
  end

  def root
    @root ||= begin
      fail!("no Gemfile in #{Dir.pwd}; run bundler-purifier in the project root") unless File.file?("Gemfile")
      Dir.pwd
    end
  end

  # The purifier lockfile: `--lockfile`, then BUNDLER_PURIFIER_LOCKFILE,
  # then bundler-purifier.lock.json beside Gemfile.lock.
  def lockfile_path
    @lockfile_path ||= File.expand_path(@lockfile_option || ENV["BUNDLER_PURIFIER_LOCKFILE"] || File.join(root, LOCK_FILE))
  end

  # Where prefetch keeps its GC roots and the gem cache: beside the
  # purifier lockfile.
  def state_dir
    File.join(File.dirname(lockfile_path), ".bundler-purifier")
  end

  def lock_name
    File.basename(lockfile_path)
  end

  # The path sources of a Gemfile.lock outside the project root, as the
  # lockfile writes them (relative to the root). Bundler's git source is a
  # kind of path source, which this leaves out.
  def external_paths(parser)
    paths = parser.sources.grep(Bundler::Source::Path).reject { |s| s.is_a?(Bundler::Source::Git) }
    paths.map { |s| s.path.to_s }.uniq.reject do |p|
      dir = File.expand_path(p, root)
      dir == root || dir.start_with?("#{root}/")
    end.sort
  end

  # The files whose content decides what the lock holds: the Gemfile, its
  # lockfile, and the gemspecs of the project (outside hidden directories
  # and vendor/) and of its path sources outside the project. A lockfile
  # made from the same definition stays current. buildBundlerProject
  # computes the same hash when it evaluates, to tell a stale lock: each
  # file contributes its name, its length in bytes and its content, each
  # followed by a newline, in the byte order of the names.
  def definition_hash
    files = ["Gemfile", "Gemfile.lock"] + Dir.glob("**/*.gemspec", base: root).reject { |f| f.start_with?("vendor/") }
    lockfile = File.join(root, "Gemfile.lock")
    if File.file?(lockfile)
      external_paths(Bundler::LockfileParser.new(File.read(lockfile))).each do |p|
        files += Dir.glob("*.gemspec", base: File.expand_path(p, root)).map { |g| File.join(p, g) }
      end
    end
    digest = Digest::SHA256.new
    files.uniq.sort.each do |f|
      path = File.expand_path(f, root)
      next unless File.file?(path)
      content = File.binread(path)
      digest << "#{f}\n#{content.bytesize}\n" << content << "\n"
    end
    "sha256-#{digest.base64digest}"
  end

  # The hash of a lockfile's content: SHA-256 of its JSON without
  # contentHash, with the keys of every object sorted and no whitespace,
  # which is how Nix's builtins.toJSON writes it. Nix checks it when it
  # reads the lock, to tell a lockfile that was edited by hand.
  def content_hash(lock)
    canonical = ->(value) do
      case value
      when Hash then value.keys.sort.to_h { |k| [k, canonical.(value[k])] }
      when Array then value.map(&canonical)
      else value
      end
    end
    "sha256-#{Digest::SHA256.base64digest(JSON.generate(canonical.(lock.except("contentHash"))))}"
  end

  # The SHA-256 that the CHECKSUMS section of a Gemfile.lock gives each
  # gem, in hex, by "name (version[-platform])".
  def gemfile_lock_checksums(text)
    section = text[/^CHECKSUMS\n(.*?)(?:\n\n|\z)/m, 1] || ""
    section.lines.filter_map do |line|
      m = line.match(/\A  (\S+ \([^)]+\)) sha256=([0-9a-f]+)/)
      [m[1], m[2]] if m
    end.to_h
  end

  def hex_to_sri(hex)
    "sha256-#{[[hex].pack("H*")].pack("m0")}"
  end

  # The Ruby version the project asks for: its .ruby-version, or the RUBY
  # VERSION section of Gemfile.lock.
  def project_ruby_version(lockfile_text = nil)
    dot = File.join(root, ".ruby-version")
    if File.file?(dot)
      version = File.read(dot).strip.delete_prefix("ruby-")
      return version unless version.empty?
    end
    lockfile_text ||= File.file?(File.join(root, "Gemfile.lock")) ? File.read(File.join(root, "Gemfile.lock")) : ""
    lockfile_text[/^RUBY VERSION\n\s+ruby (\d+\.\d+(?:\.\d+)?)/, 1]
  end

  # The bin directory of the Ruby the lock run uses: the Ruby that runs
  # this script, or nixpkgs' Ruby of the minor version the project asks
  # for when that differs.
  def lock_ruby_bindir
    @lock_ruby_bindir ||= begin
      wanted = project_ruby_version
      if wanted.nil? || wanted.split(".")[0, 2] == RUBY_VERSION.split(".")[0, 2]
        RbConfig::CONFIG["bindir"]
      else
        major, minor = wanted.split(".")
        out, status = Open3.capture2("nix-build", nixpkgs, "-A", "ruby_#{major}_#{minor}", "--no-out-link")
        fail!("the project asks for Ruby #{wanted}, and nixpkgs has no ruby_#{major}_#{minor}") unless status.success?
        File.join(out.strip, "bin")
      end
    end
  end

  # The settings of the project's .bundle/config that apply to the lock
  # run: all of them except the ones that narrow what is locked (groups)
  # or where it goes.
  LOCK_RUN_IGNORED_SETTINGS = %w[
    BUNDLE_WITHOUT BUNDLE_WITH BUNDLE_ONLY BUNDLE_PATH BUNDLE_FROZEN BUNDLE_DEPLOYMENT
    BUNDLE_CACHE_PATH BUNDLE_BIN BUNDLE_APP_CONFIG
  ].freeze

  # Bundler reads .bundle/config with its own YAML serializer, which a
  # general YAML writer's quoting can break, so the file is read and
  # written with that serializer.
  def write_lock_run_config(dir)
    require "bundler/yaml_serializer"
    config = {}
    project = File.join(root, ".bundle", "config")
    if File.file?(project)
      config = Bundler::YAMLSerializer.load(File.read(project)).reject { |k, _| LOCK_RUN_IGNORED_SETTINGS.include?(k) }
    end
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "config"), Bundler::YAMLSerializer.dump(config))
  end

  # Runs Bundler in the project with empty gem, user and cache directories,
  # so that what it fetches is everything the project needs. Its
  # configuration is the project's .bundle/config without the settings in
  # LOCK_RUN_IGNORED_SETTINGS, so every group is locked; the user's .gemrc
  # does not apply. HOME stays, so that git reaches private git sources
  # with the user's SSH keys and credential helpers.
  def lock_env(state)
    {
      "PATH" => "#{lock_ruby_bindir}:#{ENV["PATH"]}",
      "GEMRC" => File.join(state, "gemrc"),
      "XDG_CACHE_HOME" => File.join(state, "xdg-cache"),
      "XDG_CONFIG_HOME" => File.join(state, "xdg-config"),
      "XDG_DATA_HOME" => File.join(state, "xdg-data"),
      "XDG_STATE_HOME" => File.join(state, "xdg-state"),
      "GEM_HOME" => File.join(state, "gems"),
      "BUNDLE_USER_HOME" => File.join(state, "bundle-home"),
      "BUNDLE_APP_CONFIG" => File.join(state, "bundle-config"),
      "BUNDLE_CACHE_PATH" => File.join(state, "cache"),
      "BUNDLE_CACHE_ALL" => "true",
      "BUNDLE_CACHE_ALL_PLATFORMS" => "true",
      "BUNDLE_GEMFILE" => nil,
      "BUNDLE_PATH" => nil,
      "BUNDLE_WITHOUT" => nil,
      "BUNDLE_FROZEN" => nil,
      "BUNDLE_DEPLOYMENT" => nil,
    }
  end

  def remote_url(remote)
    s = remote.to_s
    s.end_with?("/") ? s : "#{s}/"
  end

  # Runs the lock run and writes the purifier lockfile, which holds only
  # what Gemfile.lock lacks (see nix/lib/lock.nix): the hashes of gem files
  # that its CHECKSUMS section does not list, of Bundler's own gem and of
  # git checkouts; the remote of a gem in a section with several remotes;
  # mirrors; the executables of the project's gemspecs; and the Ruby the
  # lock run used.
  def lock(force:)
    if !force && File.file?(lockfile_path)
      current = begin
        JSON.parse(File.read(lockfile_path))
      rescue JSON::ParserError
        {}
      end
      if current["version"] == LOCK_VERSION && current["definitionHash"] == definition_hash
        puts "bundler-purifier: #{lock_name} is up to date"
        return
      end
    end

    Dir.mktmpdir("bundler-purifier-lock") do |state|
      env = lock_env(state)
      write_lock_run_config(env["BUNDLE_APP_CONFIG"])

      unless File.file?(File.join(root, "Gemfile.lock"))
        puts "bundler-purifier: no Gemfile.lock; resolving with bundle lock"
        run!(env, "bundle", "lock", chdir: root)
      end

      run!(env, "bundle", "cache", "--all-platforms", "--no-install", chdir: root)
      cache = env["BUNDLE_CACHE_PATH"]
      text = File.read(File.join(root, "Gemfile.lock"))
      parser = Bundler::LockfileParser.new(text)
      checksums = gemfile_lock_checksums(text)
      check_platforms(parser)
      absolute = external_paths(parser).select { |p| p.start_with?("/") }
      unless absolute.empty?
        fail!("Gemfile.lock names path sources by absolute path (#{absolute.join(", ")}). A Nix build runs in a sandbox " \
              "where it can create files only in its own build directory, so it cannot put a tree at an absolute path. " \
              "Give these sources as paths relative to the Gemfile.")
      end

      gem_hashes = {}
      gem_sources = {}
      mirrors = {}
      git_hashes = {}
      executables = {}

      parser.specs.each do |spec|
        case (source = spec.source)
        when Bundler::Source::Rubygems
          file = "#{spec.full_name}.gem"
          path = File.join(cache, file)
          fail!("bundle cache did not write #{file}") unless File.file?(path)
          hash = sri(path)
          key = "#{spec.name} (#{spec.full_name.delete_prefix("#{spec.name}-")})"
          if checksums.key?(key)
            fail!("#{file} does not match its sha256 in the CHECKSUMS of Gemfile.lock") unless hex_to_sri(checksums[key]) == hash
          else
            gem_hashes[file] = hash
          end
          url = gem_url(source.remotes, file, hash)
          gem_sources[file] = url.delete_suffix("gems/#{file}") if source.remotes.size > 1
          m = mirrors_for(url)
          mirrors[file] = m unless m.empty?
        when Bundler::Source::Git
          next if git_hashes.key?(source.revision)
          git = {
            "url" => https_git_url(source.uri),
            "rev" => source.revision,
            "submodules" => source.options["submodules"] ? true : false,
          }
          git_hashes[source.revision] = git_nar_hash(git)
        when Bundler::Source::Path
          dir = File.expand_path(source.path.to_s, root)
          # A path source outside the project is a tree the Nix build
          # takes as an argument (externalPaths); it builds no gem.
          next unless dir == root || dir.start_with?("#{root}/")
          gemspec = Dir.glob("#{spec.name}.gemspec", base: dir).first || Dir.glob("*.gemspec", base: dir).first
          next unless gemspec
          exes = Bundler.load_gemspec(File.join(dir, gemspec)).executables.sort
          executables[spec.name] = exes unless exes.empty?
        end
      end

      bundler = parser.bundler_version&.to_s || Bundler::VERSION
      bundler_url = "https://rubygems.org/gems/bundler-#{bundler}.gem"
      m = mirrors_for(bundler_url)
      mirrors["bundler-#{bundler}.gem"] = m unless m.empty?

      lockfile = {
        "version" => LOCK_VERSION,
        "definitionHash" => definition_hash,
        "ruby" => capture!(File.join(lock_ruby_bindir, "ruby"), "-e", "print RUBY_VERSION"),
        "bundlerHash" => lock_bundler(bundler, env, state),
      }
      { "gemHashes" => gem_hashes, "gemSources" => gem_sources, "mirrors" => mirrors,
        "gitHashes" => git_hashes, "executables" => executables }.each do |key, value|
        lockfile[key] = value.sort.to_h unless value.empty?
      end
      lockfile["contentHash"] = content_hash(lockfile)
      FileUtils.mkdir_p(File.dirname(lockfile_path))
      File.write(lockfile_path, JSON.pretty_generate(lockfile) + "\n")
      puts "bundler-purifier: wrote #{lockfile_path}"
    end
  end

  # The URL a Nix build fetches a git source from. The Nix sandbox has no
  # SSH keys, so a source over SSH (git@host:path or ssh://host/path) is
  # locked at the HTTPS URL of the same host and path; a private repository
  # takes a credentialed fetchgit in the builder's `fetchers`.
  def https_git_url(uri)
    case uri
    when %r{\Assh://(?:[^@/]+@)?([^/:]+)(?::\d+)?/(.+)\z} then "https://#{$1}/#{$2}"
    when %r{\A(?:[^@/]+@)?([^/:]+):(?!//)(.+)\z} then "https://#{$1}/#{$2.delete_prefix("/")}"
    else uri
    end
  end

  # The hash of a git checkout as nixpkgs' fetchgit makes it, which is what
  # a Nix build fetches and checks the locked hash against.
  def git_nar_hash(git)
    cmd = ["nix-prefetch-git", "--quiet", "--url", git["url"], "--rev", git["rev"]]
    cmd << "--fetch-submodules" if git["submodules"]
    JSON.parse(capture!(*cmd)).fetch("hash")
  end

  # The URL a gem file came from. A source with one remote serves it at
  # <remote>gems/<file>. A source with several remotes (several `source`
  # lines merged into one section of an old Gemfile.lock) may have served
  # it from any of them, so each remote is asked for the file, and the one
  # whose file has the cached file's hash is locked.
  def gem_url(remotes, file, hash)
    urls = remotes.map { |r| "#{remote_url(r)}gems/#{file}" }
    return urls.first if urls.size == 1
    urls.each do |url|
      body = begin
        Gem::RemoteFetcher.fetcher.fetch_path(url)
      rescue Gem::RemoteFetcher::FetchError
        next
      end
      return url if "sha256-#{Digest::SHA256.base64digest(body)}" == hash
    end
    fail!("none of #{urls.join(", ")} serves the #{file} that bundle cache wrote")
  end

  # The hash of the gem of the Bundler of BUNDLED WITH, which a Nix build
  # installs from the gem cache rather than fetching it.
  def lock_bundler(version, env, state)
    file = "bundler-#{version}.gem"
    fetched = File.join(state, "bundler-fetch")
    FileUtils.mkdir_p(fetched)
    run!(env, "gem", "fetch", "bundler", "--version", version, "--source", "https://rubygems.org/", chdir: fetched)
    path = File.join(fetched, file)
    fail!("gem fetch did not write #{file}") unless File.file?(path)
    sri(path)
  end

  # Other URLs of a gem file: the mirror that Bundler's configuration
  # (`bundle config mirror.<source> <mirror>`, from the user's global
  # configuration, the project's .bundle/config or the environment) gives
  # its source, when there is one.
  def mirrors_for(url)
    @bundler_settings ||= Bundler::Settings.new(File.join(root, ".bundle"))
    source = url[%r{\A.*/(?=gems/[^/]+\z)}]
    mirror = @bundler_settings.mirror_for(source).to_s
    mirror = "#{mirror}/" unless mirror.end_with?("/")
    mirror == source ? [] : ["#{mirror}#{url.delete_prefix(source)}"]
  end

  def check_platforms(parser)
    platforms = parser.platforms.map(&:to_s)
    return if platforms.include?("ruby")
    missing = %w[x86_64-linux aarch64-linux].reject { |p| platforms.any? { |q| q == p || q.start_with?("#{p}-") } }
    return if missing.empty?
    warn "bundler-purifier: Gemfile.lock lists no platform for #{missing.join(", ")}; a Nix build there fails. " \
         "Run: bundle lock --add-platform #{missing.join(" ")}"
  end

  def read_lock!
    fail!("no #{lockfile_path}; run bundler-purifier lock") unless File.file?(lockfile_path)
    lock = begin
      JSON.parse(File.read(lockfile_path))
    rescue JSON::ParserError => e
      fail!("#{lock_name} is not valid JSON (#{e.message.lines.first.strip}); run bundler-purifier lock --force")
    end
    fail!("#{lock_name} is not a JSON object; run bundler-purifier lock --force") unless lock.is_a?(Hash)
    fail!("#{lock_name} has lock format version #{lock["version"]}; this bundler-purifier writes version #{LOCK_VERSION}. Run bundler-purifier lock --force") unless lock["version"] == LOCK_VERSION
    fail!("#{lock_name} was changed by hand: its content does not match its contentHash. Run bundler-purifier lock --force") unless lock["contentHash"] == content_hash(lock)
    fail!("the Gemfile, Gemfile.lock or a gemspec changed since #{lock_name} was made; run bundler-purifier lock") unless lock["definitionHash"] == definition_hash
    check_complete!(lock)
    lock
  end

  # Fails unless the lock holds everything Gemfile.lock needs from it: a
  # hash for each gem file that CHECKSUMS does not list, the remote of each
  # gem in a section with several remotes, and the hashes of Bundler's own
  # gem and of each git checkout.
  def check_complete!(lock)
    text = File.read(File.join(root, "Gemfile.lock"))
    parser = Bundler::LockfileParser.new(text)
    checksums = gemfile_lock_checksums(text)
    absent = []
    parser.specs.each do |spec|
      case (source = spec.source)
      when Bundler::Source::Rubygems
        file = "#{spec.full_name}.gem"
        key = "#{spec.name} (#{spec.full_name.delete_prefix("#{spec.name}-")})"
        absent << "a hash for #{file}" unless checksums.key?(key) || lock.dig("gemHashes", file)
        absent << "a source for #{file}" if source.remotes.size > 1 && !lock.dig("gemSources", file)
      when Bundler::Source::Git
        absent << "a hash for the git checkout #{source.uri} at #{source.revision}" unless lock.dig("gitHashes", source.revision)
      end
    end
    absent << "a hash for Bundler's gem" unless lock["bundlerHash"]
    return if absent.empty?
    fail!("#{lock_name} lacks #{absent.first}, which Gemfile.lock needs; run bundler-purifier lock")
  end

  def lib_dir
    ENV["BUNDLER_PURIFIER_LIB"] || fail!("BUNDLER_PURIFIER_LIB is not set; run bundler-purifier through its Nix package")
  end

  # The shared nix-purifiers library as a locked flake reference.
  def shared_flake
    ENV["BUNDLER_PURIFIER_SHARED_FLAKE"] || fail!("BUNDLER_PURIFIER_SHARED_FLAKE is not set; run bundler-purifier through its Nix package")
  end

  def nixpkgs
    ENV["BUNDLER_PURIFIER_NIXPKGS"] || fail!("BUNDLER_PURIFIER_NIXPKGS is not set; run bundler-purifier through its Nix package")
  end

  # The arguments that select the builder's result for this project in
  # nix/lib/realize.nix.
  def realize_args
    ["--argstr", "root", root, "--argstr", "lockFile", lockfile_path,
     "--arg", "nixpkgs", nixpkgs, "--argstr", "purifierFlake", shared_flake]
  end

  # The user's PATH, then the Ruby that runs this script, so that publish
  # uses the user's own gem and its credentials when there is one.
  def user_ruby_path
    "#{ENV["PATH"]}:#{RbConfig::CONFIG["bindir"]}"
  end

  # Realizes the gem cache and the dev shell of the lock, each kept alive
  # by a GC root beside the purifier lockfile, then installs the bundle
  # from that cache offline, in that shell. Bundler leaves marker files in
  # its cache, so the cache is a writable copy whose gem files stay links
  # into the store, and the project's .bundle/config names it as Bundler's
  # cache_path, so a later `bundle install` reads it too.
  def prefetch(args)
    read_lock!
    FileUtils.mkdir_p(state_dir)
    realize = File.join(lib_dir, "realize.nix")
    built = capture!("nix-build", realize, "-A", "gemCache", *realize_args,
                     "--out-link", File.join(state_dir, "gem-cache")).strip
    shell = File.join(state_dir, "shell")
    run!({}, "nix", "develop", "--file", realize, "devShell", *realize_args, "--profile", shell, "--command", "true",
         chdir: root)

    cache = File.join(state_dir, "cache")
    FileUtils.rm_rf(cache)
    FileUtils.mkdir_p(cache)
    Dir.children(built).each do |entry|
      source = File.join(built, entry)
      dest = File.join(cache, entry)
      if File.symlink?(source)
        File.symlink(File.readlink(source), dest)
      else
        FileUtils.cp_r(source, dest)
        FileUtils.chmod_R("u+w", dest)
      end
    end
    run!({}, "nix", "develop", shell, "--command", "bundle", "config", "set", "--local", "cache_path", cache, chdir: root)
    run!({}, "nix", "develop", shell, "--command", "bundle", "install", "--local", *args, chdir: root)
    puts "bundler-purifier: prefetched; work offline with `nix develop #{shell}`"
  end

  # Pushes each gem file of the `release` that Nix built with `gem push`.
  def publish(args)
    read_lock!
    out = capture!("nix-build", File.join(lib_dir, "realize.nix"), "-A", "release", *realize_args, "--no-out-link").strip
    gems = Dir.glob(File.join(out, "*.gem"))
    fail!("the release holds no gem file") if gems.empty?
    gems.each { |gem| run!({ "PATH" => user_ruby_path }, "gem", "push", gem, *args, chdir: root) }
  end

  USAGE = <<~USAGE
    usage: bundler-purifier [--lockfile PATH] COMMAND
      lock [--force]   record what Gemfile.lock cannot, when the Gemfile,
                       Gemfile.lock or a gemspec changed (or always)
      prefetch [ARGS]  realize the locked gems and the dev shell, and
                       install the bundle offline (ARGS go to bundle install)
      publish [ARGS]   push the gems that Nix built (ARGS go to gem push)
  USAGE

  def main(argv)
    argv = argv.dup
    if (i = argv.index("--lockfile"))
      argv.delete_at(i)
      @lockfile_option = argv.delete_at(i) || fail!("--lockfile needs a path")
    elsif (i = argv.index { |a| a.start_with?("--lockfile=") })
      @lockfile_option = argv.delete_at(i).delete_prefix("--lockfile=")
    end
    command = argv.shift
    case command
    when "lock" then lock(force: argv.delete("--force") ? true : false)
    when "prefetch" then prefetch(argv)
    when "publish" then publish(argv)
    else
      warn USAGE
      exit(command.nil? ? 1 : 2)
    end
  end
end

# The unit tests load this file without running a command.
BundlerPurifier.main(ARGV) if $PROGRAM_NAME == __FILE__
